# Database connection string (PostgreSQL / Supabase or SQLite for local dev)
# For Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# For Local SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for Teacher Session Authentication
JWT_SECRET="telugu-ai-attendance-caller-super-secret-key-change-in-production-2026"

# Voice Mode: 'mock' (simulated calls with live audio UI demo) or 'production' (real telephony API)
VOICE_MODE="mock"

# Voice Telephony Provider Credentials (Twilio / Exotel / Plivo)
VOICE_PROVIDER_API_KEY="your_voice_provider_api_key"
VOICE_PROVIDER_ACCOUNT_ID="your_voice_provider_account_id"
VOICE_PROVIDER_PHONE_NUMBER="+919876543210"

# AI Voice & Conversation API Key (Gemini / OpenAI / Deepgram)
AI_API_KEY="your_ai_service_api_key"

# Default College Name (can be overridden per teacher account)
COLLEGE_NAME="Malla Reddy University"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
